<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8">
    <title>Kartu Rencana Studi</title>
</head>
<style>
    body { font-size: 14px; }
    .table-krs { width: 100%; border-collapse: collapse; margin-top: 20px; }
    .table-krs thead th { background-color: #eeeeee; border: 1px solid #444; padding: 8px 6px; font-weight: bold; text-align: center; }
    .table-krs tbody td { border: 1px solid #888; padding: 7px 6px; vertical-align: middle; }
    .table-krs tbody tr:nth-child(even) { background-color: #f9f9f9; }
    .text-center { text-align: center; }
    .text-right { text-align: right; }
    .fakultas-title { font-size: var(--fakultas-font-size, 22px); font-weight: bold; }
</style>

<body>
    <table style="width: 100%; margin-top: -10px">
        <tr>
            <td style="width: 100px">
                <% if (logoDataUri) { %>
                    <img src="<%= logoDataUri %>" width="100px">
                <% } %>
            </td>
            <td style="text-align: center">
                <span style="font-size: 24px; font-weight: bold">MAJELIS DIKTILITBANG MUHAMMADIYAH</span> <br>
                <span style="font-size: 28px; font-weight: bold">UNIVERSITAS MUHAMMADIYAH JAMBI</span> <br>
                <span class="fakultas-title" style="--fakultas-font-size: <%= fakultasFontSize %>"><%= (saya.nama_fakultas || '').toUpperCase() %></span> <br>
                <span style="font-size: 11px; font-weight: bold; white-space: nowrap;">Jl. Kapten Pattimura, Simpang IV Sipin, Kec. Telanaipura, Kota Jambi, Jambi 36124 - Telp: (0741) 60825</span>
            </td>
        </tr>
    </table>
    <div style="border-top: 3px solid black; margin-top: 4px;"></div>
    <div style="border-top: 1px solid black; margin-top: 2px;"></div>
    <p style="text-align:center; font-weight: bold; font-size: 20px; text-decoration: underline">KARTU RENCANA STUDI</p>
    <table style="font-weight: bold;">
        <tr><td>Nama Mahasiswa</td><td>: <%= saya.nama_mahasiswa %></td></tr>
        <tr><td>NPM</td><td>: <%= saya.npm %></td></tr>
        <% if (periode) { %>
            <tr><td>Tahun Akademik</td><td>: <%= tahunAkademikLabel %></td></tr>
        <% } %>
        <tr><td>Fakultas</td><td>: <%= saya.nama_fakultas %></td></tr>
        <tr><td>Program Studi</td><td>: <%= saya.nama_program_studi %></td></tr>
    </table>

    <table class="table-krs">
        <thead>
            <tr>
                <th width="5%">No</th>
                <th width="12%">Kode</th>
                <th>Mata Kuliah</th>
                <th width="8%">SKS</th>
                <th width="20%">Jadwal</th>
            </tr>
        </thead>
        <tbody>
            <% if (!krs.krs.length) { %>
                <tr><td colspan="5" class="text-center"><em>Tidak ada mata kuliah</em></td></tr>
            <% } else { %>
                <% let totalSks = 0; %>
                <% krs.krs.forEach((item, index) => { %>
                    <% totalSks += Number(item.sks_matakuliah || 0); %>
                    <tr>
                        <td class="text-center"><%= index + 1 %></td>
                        <td class="text-center"><%= item.kode_mata_kuliah %></td>
                        <td><%= item.nama_mata_kuliah %></td>
                        <td class="text-center"><%= item.sks_matakuliah %></td>
                        <td class="text-center"><%= item.hari %><% if (item.jam_mulai) { %>, <%= item.jam_mulai %> - <%= item.jam_selesai %><% } %></td>
                    </tr>
                <% }) %>
                <tr>
                    <td colspan="3" class="text-right"><strong>Total SKS</strong></td>
                    <td class="text-center"><strong><%= totalSks %></strong></td>
                    <td></td>
                </tr>
            <% } %>
        </tbody>
    </table>

    <br>
    <table style="width:100%; margin-top:5px;">
        <tr><td style="width:50%;"></td><td style="width:50%; text-align:right;">Jambi, <%= tanggal %></td></tr>
    </table>

    <table style="width:100%;">
        <tr>
            <td style="width:50%; text-align:center;">Pembimbing Akademik,</td>
            <td style="width:50%; text-align:center;">Mahasiswa</td>
        </tr>
        <tr><td style="height:60px;"></td><td></td></tr>
        <tr>
            <td style="text-align:center; text-decoration: underline"><strong><%= saya.dosen_pa %></strong></td>
            <td style="text-align:center; text-decoration: underline"><strong><%= saya.nama_mahasiswa %></strong></td>
        </tr>
        <tr>
            <td style="text-align:center;">NIDN. <%= saya.nidn_pa %></td>
            <td style="text-align:center;">NPM. <%= saya.npm %></td>
        </tr>
    </table>
</body>

</html>
