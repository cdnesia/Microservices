# 5 database eksternal — SAMA PERSIS yang dipakai aplikasi Laravel SIMAWA asli
# (~/Herd/simawa), lihat komentar lengkap di docker-compose.yml.
DATABASE_URL_SIMAWA=mysql://user:password@host:3306/dev_simawa
DATABASE_URL_SIADE=mysql://user:password@host:3306/dev_siade_new
DATABASE_URL_SIADE_OLD=mysql://user:password@host:3306/umja
DATABASE_URL_PAYMENT=mysql://user:password@host:3306/dev_payment
DATABASE_URL_SIMAKU=mysql://user:password@host:3306/dev_simkeu_new

# Token identitas mahasiswa (header X-Student-Token) — generate: openssl rand -hex 32
STUDENT_JWT_SECRET=
STUDENT_JWT_TTL_SECONDS=7200

# Pengganti Laravel APP_KEY untuk encrypt/decrypt id internal (jadwal_id KRS, id kegiatan
# mahasiswa) yang dikirim bolak-balik ke client — generate: openssl rand -hex 32
SIMAWA_CRYPT_SECRET=

# Integrasi SIMAKU (HMAC) — dipakai /riwayat-pembayaran dan generate tagihan KKN.
# SENGAJA dibiarkan KOSONG: di aplikasi Laravel SIMAWA asli, variabel setara ini
# (services.simaku_url / hmac_secret / hmac_api_key) JUGA tidak pernah didefinisikan —
# jadi kedua endpoint itu memang belum bisa berfungsi sampai kredensial SIMAKU asli
# didapat dari pemilik sistem itu. Isi di sini kalau sudah ada.
SIMAKU_URL=
SIMAKU_HMAC_SECRET=
SIMAKU_HMAC_API_KEY=


# --- Kapasitas & resource (opsional, semua punya default aman) ---
# DB_POOL_SIZE ikut budget total lintas semua service yang nempel ke database yang sama —
# lihat CLAUDE.md bagian "Kapasitas Database" sebelum menaikkan.
DB_POOL_SIZE=10
SERVICE_MEM_LIMIT=256m
SERVICE_CPUS=0.5
