JWT_SECRET=ganti-dengan-random-string-panjang-di-production
DB_USER=gateway
DB_PASSWORD=ganti-dengan-password-random
DB_NAME=gateway

# --- Kapasitas database (opsional, semua punya default aman untuk VPS kecil) ---
# Sesuaikan begitu tahu spek CPU/RAM host asli — lihat rumus di CLAUDE.md bagian
# "Kapasitas Database". Budget koneksi: AUTH_DB_POOL_SIZE di sini + total connectionLimit
# semua service bisnis yang nempel ke database yang sama HARUS punya headroom di bawah
# DB_MAX_CONNECTIONS, jangan pas-pasan.
DB_MAX_CONNECTIONS=300
DB_BUFFER_POOL_SIZE=512M
DB_MEM_LIMIT=1g
DB_MEM_RESERVATION=512m
DB_CPUS=1.0
AUTH_DB_POOL_SIZE=20
AUTH_SERVICE_MEM_LIMIT=512m
AUTH_SERVICE_CPUS=1.0
