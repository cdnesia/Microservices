JWT_SECRET=ganti-dengan-random-string-panjang-di-production

# --- MariaDB 10.6, dibundle di compose ini sendiri (container "mariadb", di gateway-net) ---
# DB_HOST/DB_NAME biarkan default kecuali ada alasan spesifik untuk diganti. DB_USER/
# DB_PASSWORD dipakai untuk bikin user MariaDB itu sendiri (lewat MARIADB_USER/
# MARIADB_PASSWORD di docker-compose.yml) DAN untuk auth-service connect ke situ — SENGAJA
# random, bukan nama/kata yang mudah ditebak (username juga, bukan cuma password — defense in
# depth, walau username bukan secret utama). Generate sebelum isi .env:
#   DB_USER=$(openssl rand -hex 6)
#   DB_PASSWORD=$(openssl rand -base64 24 | tr -d '=+/' | cut -c1-28)
# PENTING: MARIADB_USER/MARIADB_PASSWORD cuma dibaca SEKALI saat volume mariadb_data masih
# kosong (first init) — ganti nilai ini setelah volume terisi TIDAK otomatis mengganti user
# yang sudah ada, auth-service akan gagal connect. Kalau mau ganti di deployment yang sudah
# jalan: wipe `docker compose down -v` (baca ulang init.sql otomatis) atau buat user baru
# manual via root (lihat "Database Eksternal (MariaDB Bersama)" bagian root password).
DB_HOST=mariadb
DB_PORT=3306
DB_USER=ganti-dengan-db-user-random
DB_PASSWORD=ganti-dengan-password-random
DB_NAME=gateway_auth

# --- Kapasitas (opsional, default aman) ---
AUTH_DB_POOL_SIZE=20
AUTH_SERVICE_MEM_LIMIT=512m
AUTH_SERVICE_CPUS=1.0
