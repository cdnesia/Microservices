JWT_SECRET=ganti-dengan-random-string-panjang-di-production

# --- Koneksi ke instance MariaDB eksternal (bukan dibundle lagi di compose ini) ---
# DB_HOST = IP routable ke instance MariaDB itu (mis. alamat WireGuard host "biznet",
# BUKAN nama container Docker) — lihat CLAUDE.md bagian "Database Eksternal (MariaDB
# Bersama)" untuk kredensial & cara setup user-nya.
DB_HOST=ganti-dengan-ip-database
DB_PORT=3306
DB_USER=ganti-dengan-db-user
DB_PASSWORD=ganti-dengan-password-random
DB_NAME=ganti-dengan-nama-database

# --- Kapasitas (opsional, default aman) ---
# AUTH_DB_POOL_SIZE di sini + total connectionLimit semua consumer lain yang nempel ke
# instance mariadb eksternal yang SAMA harus punya headroom di bawah max_connections
# instance itu (lihat CLAUDE.md bagian "Kapasitas Database").
AUTH_DB_POOL_SIZE=20
AUTH_SERVICE_MEM_LIMIT=512m
AUTH_SERVICE_CPUS=1.0
