JWT_SECRET=ganti-dengan-random-string-panjang-di-production

# --- MariaDB 10.6, compose TERPISAH di ../mariadb/ (container "mariadb-server") ---
# DB_USER/DB_PASSWORD/DB_NAME di sini HARUS SAMA PERSIS dengan yang diisi di ../mariadb/.env —
# compose itu yang membuat user MariaDB-nya, auth-service di sini cuma connect pakai kredensial
# yang sama. DB_HOST/DB_PORT biarkan default kecuali ada alasan spesifik untuk diganti.
DB_HOST=mariadb-server
DB_PORT=3306
DB_USER=ganti-dengan-db-user-random
DB_PASSWORD=ganti-dengan-password-random
DB_NAME=gateway_auth

# --- Kapasitas (opsional, default aman) ---
AUTH_DB_POOL_SIZE=20
AUTH_SERVICE_MEM_LIMIT=512m
AUTH_SERVICE_CPUS=1.0
