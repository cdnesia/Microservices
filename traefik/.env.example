# Copy ke .env (cp .env.example .env) lalu sesuaikan per environment. Compose file
# (docker-compose.yml) sendiri tidak perlu diubah antar dev/VPS — cukup lewat file ini.

# Dev di mesin ini (Mac + Laravel Herd): biarkan default (8081/8443) karena port 80/443
# host dipakai Herd untuk domain .test lokal.
# VPS/server produksi (tanpa Herd): isi 80 dan 443 di bawah supaya Cloudflare bisa connect
# ke origin port default tanpa konfigurasi "Origin Rules" tambahan di dashboard Cloudflare.
TRAEFIK_HTTP_PORT=8081
TRAEFIK_HTTPS_PORT=8443

# Dashboard Traefik — selalu di-bind ke 127.0.0.1 (loopback) di docker-compose.yml, tidak
# pernah reachable dari luar mesin ini terlepas dari nilai port ini. Biarkan default kecuali
# port 8080 di mesin ini sudah dipakai proses lain.
TRAEFIK_DASHBOARD_PORT=8080
