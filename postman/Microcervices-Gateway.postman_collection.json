    {
      "name": "4. Rate Limit per-client",
      "item": [
        {
          "name": "4.1 Flood demo-client - self-contained (cukup klik Send)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Request ini sendiri = hit ke-1. Script di bawah menembak 59 request tambahan",
                  "// secara paralel lewat pm.sendRequest, jadi total ~60 hit dalam waktu singkat —",
                  "// cukup klik Send SEKALI, tidak perlu setting Collection Runner.",
                  "function fireOnce() {",
                  "  return new Promise((resolve) => {",
                  "    pm.sendRequest({",
                  "      url: pm.collectionVariables.get('base_url') + '/api/ruangan/list',",
                  "      method: 'GET',",
                  "      header: { Authorization: 'Bearer ' + pm.collectionVariables.get('access_token') }",
                  "    }, (err, res) => resolve(res ? res.code : 0));",
                  "  });",
                  "}",
                  "",
                  "(async () => {",
                  "  const results = [pm.response.code];",
                  "  const extra = await Promise.all(Array.from({ length: 59 }, fireOnce));",
                  "  results.push(...extra);",
                  "",
                  "  const count200 = results.filter((c) => c === 200).length;",
                  "  const count429 = results.filter((c) => c === 429).length;",
                  "  // 500 dihitung 'lolos gateway, bukan crash' — bukan 200 murni karena service-ruangan",
                  "  // butuh DATABASE_URL_SIADE_OLD asli (lihat CLAUDE.md); sebelum kredensial itu diisi,",
                  "  // request yang TIDAK kena rate limit akan balas 500 (query gagal connect), bukan 200.",
                  "  // Yang membuktikan rate limiter jalan tetap count429 > 0 di bawah.",
                  "  const countAllowed = results.filter((c) => c === 200 || c === 500).length;",
                  "  const countOther = results.filter((c) => c !== 200 && c !== 429 && c !== 500).length;",
                  "  console.log(`Hasil 60 request paralel -> 200/500 (lolos gateway): ${countAllowed}, 429: ${count429}, lainnya: ${countOther}`);",
                  "",
                  "  pm.test('Tidak ada status selain 200/429/500 (service tidak crash)', function () {",
                  "    pm.expect(countOther).to.eql(0);",
                  "  });",
                  "  pm.test('Setidaknya ada satu 429 (rate limit per-client aktif, burst=40)', function () {",
                  "    pm.expect(count429).to.be.above(0);",
                  "  });",
                  "})();"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": {
              "raw": "{{base_url}}/api/ruangan/list",
              "host": ["{{base_url}}"],
              "path": ["api", "ruangan", "list"]
            },
            "description": "PENTING: jalankan '1. Auth Flow' dulu (minimal request 1.1) supaya {{access_token}} terisi, baru klik Send di sini. Request ini otomatis menembak total ~60 request paralel ke /api/ruangan/list pakai token demo-client (average=20/burst=40) — hasilnya harus campuran 200-atau-500 (lolos gateway) dan 429 (kena limit), tidak pernah error lain/hang."
          },
          "response": []
        },
        {
